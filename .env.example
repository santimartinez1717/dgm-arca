# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# Identificación del equipo (sale en GET /health)
ARCA_TEAM=umbral
ARCA_DOMAIN="analisis de inversion inmobiliaria para alquiler"

# Fase 1: adaptador entrenado (GRPO 2, el modelo final; en Hugging Face, privado) y verificador
ARCA_RLM_ADAPTER=rlm/weights/grpo2_lora
ARCA_RLM_VERIFIER=euro
# Solo en Mac: el GRPO 2 en 8 bits con MLX, en lugar del adaptador (docs/servir_api.md)
# ARCA_RLM_MLX=rlm/weights/grpo2_mlx_8bit

# Fase 2: el modelo que atiende POST /tools
# ARCA_TOOLS_MODEL=Qwen/Qwen3-1.7B
# ARCA_TOOLS_ADAPTER=rlm/weights/final_rlm_lora   # vacío: el modelo base, sin adaptador
# ARCA_TOOLS_THINKING=0                           # 1: Qwen3 piensa antes de cada turno
# ARCA_TOOLS_PROMPT=native                        # native (plantilla de Qwen3) o course (el de clase)
# ARCA_PORTFOLIO_DB=outputs/portfolio.sqlite      # la cartera de save_to_portfolio
